{
    "position": "bottom",
    "layer": "top",
    "mode": "hide",
    "modifier-reset": "release",
    "ipc": true,
    "reload_style_on_change": true,
    "exclusive": false,
    "height": 60,
    "spacing": 0,
    "margin-bottom": 16,

    "modules-center": [
        "group/bar"
    ],

    "group/bar": {
        "orientation": "horizontal",
        "modules": [
            "sway/workspaces",
            "clock",
            "tray",
            "cpu",
            "memory",
            "temperature",
            "pulseaudio",
            "network",
            "battery",
            "backlight"
        ]
    },

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "tooltip": false
    },

    "clock": {
        "format": "{:%a %d, %I:%M %p}",
        "tooltip": false
    },

    "tray": {
        "spacing": 8,
        "tooltip": false
    },

    "cpu": {
        "format": "<span foreground='#FABD2F'></span> {usage}%",
        "interval": 2,
        "states": {
            "critical": 90
        }
    },

    "memory": {
        "format": "<span foreground='#FABD2F'>󰍛</span> {percentage}%",
        "interval": 2,
        "states": {
            "critical": 80
        }
    },

    "temperature": {
        "hwmon-by-name": "k10temp",
        "input-filename": "temp1_input",
        "format": "<span foreground='#FABD2F'></span> {temperatureC}°C",
        "interval": 5,
        "warning-threshold": 75,
        "critical-threshold": 90,
        "tooltip": false
    },

    "pulseaudio": {
        "format": "<span foreground='#FABD2F'>{icon}</span> {volume}%",
        "format-muted": "<span foreground='#FABD2F'></span> mute",
        "format-icons": {
            "default": ["", ""]
        },
        "scroll-step": 5,
        "max-volume": 150,
        "on-click": "pavucontrol",
        "tooltip": false
    },

    "network": {
        "format-wifi": "<span foreground='#FABD2F'></span> {signalStrength}%",
        "format-ethernet": "<span foreground='#FABD2F'></span> up",
        "format-disconnected": "<span foreground='#FABD2F'></span>",
        "tooltip": false
    },

    "battery": {
        "format": "<span foreground='#FABD2F'>{icon}</span> {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "interval": 5,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "tooltip": false
    },

    "backlight": {
        "device": "nvidia_0",
        "format": "<span foreground='#FABD2F'></span> {percent}%",
        "interval": 2,
        "scroll-step": 5,
        "tooltip": false
    }
}
